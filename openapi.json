{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud Catcher AI Tools",
    "version": "0.1.0",
    "description": "Semantic AI-facing operations layered over the Cloud Catcher REST API."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/ai-tools": {
      "get": {
        "operationId": "list_cloud_catcher_tools",
        "summary": "List available semantic AI tools",
        "responses": {"200": {"description": "Tool catalogue"}}
      }
    },
    "/ai-tools/import-cloud-photos": {
      "post": {
        "operationId": "import_cloud_photos",
        "summary": "Import a whole cloud-photo batch in one call",
        "description": "Send one metadata JSON field plus image fields photo0..photoN. The metadata describes an optional session, defaults, and detections for each image.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["metadata"],
                "properties": {
                  "metadata": {"type": "string", "description": "JSON string containing session/defaults/catches metadata."},
                  "photo0": {"type": "string", "format": "binary", "description": "First cloud image. Additional files use photo1, photo2, etc."}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "Created session, photos, detections, snippets, and summary"}}
      }
    },
    "/ai-tools/correct-detection": {
      "post": {
        "operationId": "correct_detection",
        "summary": "Correct an existing cloud detection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["detectionId"],
                "properties": {
                  "detectionId": {"type": "string"},
                  "cloudTypeId": {"type": "string"},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                  "status": {"type": "string", "enum": ["proposed", "confirmed", "rejected"]},
                  "region": {"type": "object"},
                  "notes": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "Updated detection"}}
      }
    },
    "/ai-tools/add-detection": {
      "post": {
        "operationId": "add_detection",
        "summary": "Add a cloud detection to an existing photo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["photoId", "cloudTypeId"],
                "properties": {
                  "photoId": {"type": "string"},
                  "cloudTypeId": {"type": "string"},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                  "status": {"type": "string", "enum": ["proposed", "confirmed", "rejected"]},
                  "region": {"type": "object"},
                  "notes": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "Created detection"}}
      }
    },
    "/ai-tools/get-missing-clouds": {
      "get": {
        "operationId": "get_missing_clouds",
        "summary": "Get uncaught Level 1 cloud genera",
        "parameters": [{"name": "location", "in": "query", "required": false, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Missing cloud IDs"}}
      }
    },
    "/ai-tools/get-collection-progress": {
      "get": {
        "operationId": "get_collection_progress",
        "summary": "Get Level 1 collection progress",
        "parameters": [{"name": "location", "in": "query", "required": false, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Collection progress"}}
      }
    }
  }
}
